
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified Boolean?
  image         String?
  username      String?        @unique
  birthDate     DateTime?
  birthTime     String?
  location      String?
  latitude      Float?
  longitude     Float?
  timezone      String?
  coins         Int            @default(3)
  lastClaimedAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  astrologyData AstrologyData?
  conversations Conversation[]
  remedies      Remedy[]
  profiles      Profile[]

  @@map("user")
}

model Conversation {
  id                    String    @id @default(cuid())
  userId                String
  title                 String
  profileId             String?
  knowledgeSource       String?
  qwenChatId            String?
  geminiConversationId  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages              Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String // "user" or "assistant"
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
  @@map("verification")
}

model AstrologyData {
  id                 String    @id @default(cuid())
  userId             String    @unique
  planets            Json?
  extended           Json?
  navamsa            Json?
  panchang           Json?
  natal              Json?
  dashaInfo          Json?
  mahaDashas         Json?
  yoginiDasha        Json?
  transit            Json?
  myTransit              Json?
  myTransitUpdatedAt     DateTime?
  lagnaGochar            Json?
  lagnaGocharUpdatedAt   DateTime?
  chandraGochar          Json?
  chandraGocharUpdatedAt DateTime?
  aiPersona              String?   @db.Text
  transitPredictions     Json?
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TransitCache {
  id        String   @id @default(cuid())
  timezone  String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

model Remedy {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "mantra" | "gemstone" | "ritual" | "charity" | "lifestyle"
  title       String
  description String   @db.Text
  source      String   // "ai_chat" | "transit_prediction" | "manual"
  sourceRef   String?  // message ID or transit date
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("remedy")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String
  name      String
  relation  String   @default("self")
  avatar    String   @default("cat")
  color     String   @default("indigo")
  birthDate DateTime?
  birthTime String?
  location  String?
  latitude  Float?
  longitude Float?
  timezone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profile")
}

model KnowledgeChunk {
  id        String   @id @default(cuid())
  source    String
  chapter   String
  title     String
  content   String   @db.Text
  tags      String?
  createdAt DateTime @default(now())

  @@index([source])
  @@map("knowledge_chunk")
}
